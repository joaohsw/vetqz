# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# CORS — origens permitidas (separadas por vírgula)
# Produção: https://seu-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Limites de upload (em MB)
# A Vercel limita requests de Functions a 4,5 MB.
MAX_PDF_SIZE_MB=4
MAX_AUDIO_SIZE_MB=4

# Retenção de arquivos: os PDFs e áudios expiram; o histórico de estudo permanece.
MATERIAL_RETENTION_DAYS=7

# Use o mesmo valor de CRON_SECRET configurado na Vercel para a limpeza diária.
CRON_SECRET=troque-por-um-segredo-longo-e-aleatorio
